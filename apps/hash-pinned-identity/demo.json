{
  "app": "hash-pinned-identity",
  "claim": "A launcher refuses to run any executable whose resolved absolute path and SHA-256 don't both match a policy pinned outside the workspace \u2014 even if the name on PATH is identical.",
  "enforcement": "deterministic",
  "denial_type": "IdentityMismatch",
  "steps": [
    {
      "label": "the pinned path, with the pinned contents",
      "request": {
        "name": "deploy-tool",
        "path": "trusted_bin/deploy-tool",
        "sha256": "6a0e49c03f83f6d9..."
      },
      "outcome": "allowed",
      "result": "#!/bin/sh\necho toy-deploy-tool v1\n",
      "reason": "",
      "detail": "",
      "evidence": "both path and hash matched the pinned identity",
      "note": ""
    },
    {
      "label": "an impostor earlier on PATH, byte-identical contents",
      "request": {
        "name": "deploy-tool",
        "path": "attacker_bin/deploy-tool",
        "sha256": "6a0e49c03f83f6d9..."
      },
      "outcome": "denied",
      "result": "",
      "reason": "path_mismatch",
      "detail": "name='deploy-tool' resolved='<tmp>//attacker_bin//deploy-tool' pinned='<tmp>//trusted_bin//deploy-tool'",
      "evidence": "",
      "note": "Identical bytes are not enough. The pin is path AND hash, so a same-named file in another directory is a different identity."
    },
    {
      "label": "the pinned path, contents tampered with",
      "request": {
        "name": "deploy-tool",
        "path": "trusted_bin/deploy-tool",
        "sha256": "568fdb876ceb13b2..."
      },
      "outcome": "denied",
      "result": "",
      "reason": "hash_mismatch",
      "detail": "name='deploy-tool' path='<tmp>//trusted_bin//deploy-tool' expected=6a0e49c03f83f6d9d8bd4041da85e407695e6eb455d5fde9a9d5c2aa61d97985 actual=568fdb876ceb13b2aa5605d496b7fbedde61691104060d3073fa89c222ebec4c",
      "evidence": "",
      "note": "The correct location is not enough either."
    },
    {
      "label": "a name the policy never pinned",
      "request": {
        "name": "unregistered-tool",
        "path": "trusted_bin/deploy-tool"
      },
      "outcome": "denied",
      "result": "",
      "reason": "no pinned identity for name='unregistered-tool'",
      "detail": "",
      "evidence": "",
      "note": "Unknown means refused, never 'probably fine'."
    }
  ]
}
