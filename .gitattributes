# Normalize every text file to LF, in the repository and in the working tree.
#
# Demo recordings and rendered pages are regenerated by Python on whatever
# platform is running, and CI compares them with `git diff --exit-code`. With a
# CRLF working tree on Windows and an LF one on Linux, that comparison depended
# on the checkout rather than on the code — which is the opposite of what it is
# there to check.
* text=auto eol=lf

# Binary: never line-ending converted, never diffed as text.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
